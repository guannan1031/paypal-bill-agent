# ===== PayPal 沙箱（免费注册 https://developer.paypal.com）=====
# 不填也能跑：自动进入 MOCK 演示模式（完整走通付款闭环，供视频/演示用，标注为模拟）
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# 沙箱 API 地址（一般不用改）
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# ===== AI 账单解析（可选，不填走本地规则解析，同样可跑）=====
# 兼容 OpenAI 风格的 chat/completions，国内可达（如 DeepSeek/豆包）
AI_BILL_API_KEY=
AI_BILL_BASE_URL=https://api.deepseek.com
AI_BILL_MODEL=deepseek-chat

# ===== 运行时 =====
PORT=8878
